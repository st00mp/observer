# Ce fichier est automatiquement utilisé par direnv pour activer l'environnement
# lorsque vous entrez dans le répertoire du projet

# Activer directement l'environnement virtuel existant
if [ -d .venv ]; then
  export VIRTUAL_ENV=$(pwd)/.venv
  export PATH="$VIRTUAL_ENV/bin:$PATH"
  export VIRTUAL_ENV_DISABLE_PROMPT=1
fi

# Variables d'environnement du projet
export PYTHONPATH="$(pwd):$PYTHONPATH"
export REDIS_HOST=localhost
export REDIS_PORT=6379

# Ajouter le répertoire des scripts au PATH
PATH_add "$(pwd)/scripts"

# Message d'information
echo "
🚀 🚀 🚀 Environnement Syntinel activé ! 🚀 🚀 🚀"
echo "📌 Python: $(python --version 2>&1)"
echo "📌 Chemin Python: $(which python)"
echo "📌 Env: $VIRTUAL_ENV"
echo "📁 PYTHONPATH: $PYTHONPATH"
echo ""
